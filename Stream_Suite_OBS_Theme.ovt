/* Stream Suite OBS Theme 0.1.3
 * Author: DMITRII (DIMI0007)
 * A small OBS Studio 33 theme variant for built-in docks.
 * It extends OBS Yami; no OBS theme files are copied here.
 */

@OBSThemeMeta {
    name: 'Stream Suite OBS Theme';
    id: 'com.dimi0007.StreamSuiteOBSTheme';
    extends: 'com.obsproject.Yami';
    author: 'DMITRII';
    dark: 'true';
}

/* Main OBS window: menu and the chrome around the video preview. */
QMenuBar#menubar {
    background: #101b28;
    color: #c4d2e2;
    border-bottom: 1px solid #2b3b4d;
    font-size: 13px;
}

QMenuBar#menubar::item {
    background: transparent;
    color: #c4d2e2;
    padding: 4px 7px;
}

QMenuBar#menubar::item:selected,
QMenuBar#menubar::item:pressed {
    background: #19372f;
    color: #e0ede8;
    border-radius: 4px;
}

QMenu#menu_File,
QMenu#menuBasic_MainMenu_Edit,
QMenu#viewMenu,
QMenu#profileMenu,
QMenu#sceneCollectionMenu,
QMenu#menuTools,
QMenu#menuBasic_MainMenu_Help {
    background: #101b28;
    color: #c4d2e2;
    border: 1px solid #2b3b4d;
}

QMenu#menu_File::item:selected,
QMenu#menuBasic_MainMenu_Edit::item:selected,
QMenu#viewMenu::item:selected,
QMenu#profileMenu::item:selected,
QMenu#sceneCollectionMenu::item:selected,
QMenu#menuTools::item:selected,
QMenu#menuBasic_MainMenu_Help::item:selected {
    background: #19372f;
    color: #e0ede8;
}

QWidget#centralwidget,
QWidget#canvasEditor,
QWidget#previewContainer,
QWidget#previewXContainer {
    background: #0e1925;
    color: #c4d2e2;
}

QFrame#contextContainer {
    background: #101b28;
    color: #c4d2e2;
    border: 1px solid #2b3b4d;
    border-radius: 6px;
}

QFrame#contextContainer QLabel {
    color: #c4d2e2;
    font-size: 12px;
}

QFrame#contextContainer QPushButton,
QWidget#previewXContainer QPushButton,
QWidget#previewXContainer QComboBox {
    background: #1a2a39;
    color: #c9d8e8;
    border: 1px solid #2d4257;
    border-radius: 5px;
}

QFrame#contextContainer QPushButton:hover,
QWidget#previewXContainer QPushButton:hover,
QWidget#previewXContainer QComboBox:hover {
    background: #25394a;
    border-color: #49657a;
}

OBSPreviewScalingLabel#previewScalePercent {
    color: #afc2d5;
    font-size: 12px;
}

/* Built-in dock headers only. Third-party docks keep their own title styling. */
OBSDock#scenesDock::title,
OBSDock#sourcesDock::title,
OBSDock#mixerDock::title,
OBSDock#transitionsDock::title,
OBSDock#controlsDock::title {
    background: #0b131e;
    color: #e7fff4;
    border-bottom: 1px solid #263244;
}

/* Native scenes, sources, transitions and controls. No global QWidget rule. */
#scenesFrame,
#sourcesFrame,
#transitionsFrame,
#controlsFrame,
#stackedMixerArea {
    background: #080f18;
    color: #dfe8ff;
}

SceneTree#scenes,
SourceTree#sources {
    background: #0b131e;
    color: #dfe8ff;
    border: 1px solid #263244;
    border-radius: 6px;
}

SceneTree#scenes::item:selected,
SourceTree#sources::item:selected {
    background: #12332e;
    color: #e7fff4;
    border: 1px solid #197657;
    border-radius: 4px;
}

SceneTree#scenes::item:hover,
SourceTree#sources::item:hover {
    background: #142633;
    border: 1px solid #38516d;
}

#scenesToolbar QToolButton,
#sourcesToolbar QToolButton {
    background: #101925;
    color: #c8d8ee;
    border: 1px solid #263244;
    border-radius: 5px;
}

#scenesToolbar QToolButton:hover,
#sourcesToolbar QToolButton:hover {
    background: #182b3b;
    border-color: #3a6071;
}

#transitionsFrame QComboBox {
    background: #101925;
    color: #dfe8ff;
    border: 1px solid #344865;
    border-radius: 5px;
}

#controlsFrame QPushButton {
    background: #182434;
    color: #e1ebff;
    border: 1px solid #344865;
    border-radius: 6px;
}

#controlsFrame QPushButton:hover {
    background: #23364a;
    border-color: #4d7185;
}

#controlsFrame QPushButton:pressed {
    background: #10202d;
}

#streamButton.state-active,
#broadcastButton.state-active {
    background: #0c5844;
    border-color: #00d58a;
    color: #e7fff4;
}

#recordButton.state-active,
#pauseRecordButton.state-active {
    background: #782835;
    border-color: #ff647e;
    color: #fff1f3;
}

/* Built-in audio mixer. Keep green/yellow/red level semantics. */
#mixerDock VolumeControl,
#mixerDock VolumeMeter {
    background: #0b131e;
}

#mixerDock VolumeName QLabel,
#mixerDock VolumeControl QLabel {
    color: #dfe8ff;
}

#hVolumeWidgets VolumeControl {
    border-bottom: 1px solid #263244;
}

#mixerDock QSlider::groove:horizontal {
    background: #1d3042;
    border: 1px solid #344865;
    border-radius: 3px;
}

#mixerDock QSlider::sub-page:horizontal {
    background: #34cce9;
    border-radius: 3px;
}

#mixerDock QSlider::handle:horizontal {
    background: #e7fff4;
    border: 1px solid #65dbe0;
    border-radius: 5px;
}

#mixerDock VolumeMeter {
    color: #9cb2c9;
    qproperty-backgroundNominalColor: #10382d;
    qproperty-backgroundWarningColor: #4c3a16;
    qproperty-backgroundErrorColor: #4f1d2b;
    qproperty-foregroundNominalColor: #00df8c;
    qproperty-foregroundWarningColor: #ffcd57;
    qproperty-foregroundErrorColor: #ff647e;
    qproperty-magnitudeColor: #263244;
    qproperty-majorTickColor: #c5d3e6;
    qproperty-minorTickColor: #70829a;
}
